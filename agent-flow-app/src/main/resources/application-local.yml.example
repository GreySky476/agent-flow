# --- RAG 嵌入模型 ---
# 启用 RAG 功能时需要配置
rag:
  embedding:
    api-key: sk-your-siliconflow-key    # 替换为你的 SiliconFlow API Key
    base-url: https://api.siliconflow.cn/v1
    model-name: BAAI/bge-large-zh-v1.5
    dimension: 1024
