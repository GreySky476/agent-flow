# ============================================
# Agent Flow 本地开发配置模板
# 复制此文件为 application-local.yml 并填写真实 API Key
# cp application-local.yml.example application-local.yml
# ============================================

# --- LLM 模型配置 ---
# 至少配置一个模型，推荐 DeepSeek（国内可直接使用）
models:
  list:
    - name: deepseek-v4-flash
      type: openai
      api-key: sk-your-deepseek-key     # 替换为你的 DeepSeek API Key
      base-url: https://api.deepseek.com
      model-name: deepseek-v4-flash
      reasoning-effort: none            # 禁用思考模式（避免工具调用报错）
      cost-tier: low

#    - name: tencent/hy3-preview:free
#      type: openai
